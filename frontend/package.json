{
  "name": "gate-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../deploy/local/.env next dev",
    "build:local": "NODE_ENV=production bun --env-file=../deploy/local/.env next build",
    "build:dev": "NODE_ENV=production bun --env-file=../deploy/dev/.env next build",
    "build:prod": "NODE_ENV=production bun --env-file=../deploy/prod/.env next build",
    "start": "next start",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "knip"
  },
  "dependencies": {
    "@mantine/core": "^8.3.10",
    "@mantine/dropzone": "^8.3.10",
    "@mantine/form": "^8.3.10",
    "@mantine/hooks": "^8.3.10",
    "@mantine/notifications": "^8.3.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-document-load": "^0.66.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tabler/icons-react": "^3.36.0",
    "@vercel/otel": "^2.1.3",
    "clsx": "^2.1.1",
    "katex": "^0.16.27",
    "next": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.19.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.3.1",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3"
  }
}
