# General
ENV=dev
ADDRESS=0.0.0.0:13000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/gate?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gate
POSTGRES_SSLMODE=disable

# Redis / Valkey
REDIS_URL=redis://:redis@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB_INDEX=0

# NATS
NATS_URL=nats://localhost:4222
NATS_HOST=localhost
NATS_PORT=4222

# Admin Default Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# S3 / SeaweedFS / Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=data
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=gate_s3_key
S3_SECRET_KEY=gate_s3_secret

# Judge & Sandbox
GOJUDGE_GRPC_ADDR=localhost:5051
JUDGE_WORKER_COUNT=4
JUDGE_TEMP_DIR=/tmp/judge
JUDGE_TIMEOUT=300000
JUDGE_MAX_RETRIES=3

# Telemetry / OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=gate-backend
OTEL_SERVICE_VERSION=0.1.0
OTEL_INSECURE=true
