# Domain & Deployment
DOMAIN_NAME=steins.ru
IMAGE_TAG=prod

# Backend Configuration
BACKEND_ADDRESS=0.0.0.0:8080
BACKEND_PRIVATE_ADDRESS=0.0.0.0:8081
RESEND_API_KEY=re_123456789
EMAIL_FROM=Gate <no-reply@steins.ru>
APP_BASE_URL=https://steins.ru

# Frontend Configuration
# Configure these four values as GitHub prod environment variables before deployment.
# NEXT_PUBLIC_* values are embedded at image build time; rebuild to change them.
# Only BACKEND_API_URL is supplied to the running frontend container.
BACKEND_API_URL=http://gate-backend-prod:8080
NEXT_PUBLIC_BACKEND_API_URL=/api
NEXT_PUBLIC_APP_URL=https://steins.ru
NEXT_PUBLIC_WEBSOCKET_URL=wss://steins.ru/ws

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_APP_DB=prod_app

# Redis / Valkey
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_password
REDIS_DB_INDEX=0

# NATS
NATS_HOST=nats
NATS_PORT=4222

# S3 / SeaweedFS
STORAGE_TYPE=s3
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=gate_s3_key
S3_SECRET_KEY=replace_with_secure_key
