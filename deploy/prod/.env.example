# Environment
ENV=prod
NODE_ENV=production

# Backend Configuration
BACKEND_ADDRESS=0.0.0.0:8080
BACKEND_PRIVATE_ADDRESS=0.0.0.0:8081

# Postgres Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
# Default maintenance DB
POSTGRES_DB=postgres
# Specific databases
POSTGRES_APP_DB=prod_app

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB_INDEX=2

# NATS Configuration
NATS_HOST=nats
NATS_PORT=4222

# S3 / SeaweedFS Configuration (required)
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# Domain & Image
DOMAIN_NAME=steins.ru
IMAGE_TAG=prod

# Frontend URLs
NEXT_PUBLIC_APP_URL=https://steins.ru
NEXT_PUBLIC_BACKEND_API_URL=/api
BACKEND_API_URL=http://gate-backend-prod:8080
NEXT_PUBLIC_WEBSOCKET_URL=wss://steins.ru/ws

ALLOWED_ORIGINS=https://steins.ru

# Telemetry Configuration
# Backend: OTLP over gRPC to collector gRPC receiver (4317)
BACKEND_OTEL_ENDPOINT=otel-collector:4317
# Frontend server: OTLP over HTTP to collector HTTP receiver (4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
NEXT_PUBLIC_OTEL_EXPORTER_URL=http://localhost/otlp/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=gate-frontend-browser
OTEL_SERVICE_NAME=gate-frontend
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_ADMIN_PASSWORD

