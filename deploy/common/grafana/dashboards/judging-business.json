          "expr": "(sum(judge_submissions_total{verdict=\"Accepted\", contest_id=~\"$contest_id\", problem_id=~\"$problem_id\", language=~\"$language\"}) / sum(judge_submissions_total{contest_id=~\"$contest_id\", problem_id=~\"$problem_id\", language=~\"$language\"})) * 100",
