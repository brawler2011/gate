      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(judge_submissions_total{contest_id=~\"$contest_id\", problem_id=~\"$problem_id\", language=~\"$language\", verdict=~\"$verdict\"})",
          "legendFormat": "Total Submissions",
          "range": true,
          "refId": "A"
