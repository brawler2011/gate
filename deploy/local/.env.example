# Environment
ENV=local
NODE_ENV=development

# Backend Configuration
ADDRESS=0.0.0.0:8080
LOCAL_STORAGE_PATH=backend/data

# Frontend Configuration
BACKEND_API_URL=http://localhost:8080

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
