# Copy to deploy/local/.env; non-secret settings belong in deploy/local/config.yaml.
# task infra:up and task cluster:deploy create the services with these secrets.

POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redis
S3_ACCESS_KEY=gate
S3_SECRET_KEY=gate-secret

# NodePorts of task infra:up (deploy/local/gate-infra.yaml).
POSTGRES_DSN=postgres://postgres:postgres@localhost:30432/gate?sslmode=disable
REDIS_URL=redis://:redis@localhost:30379/0
NATS_URL=nats://localhost:30422
# Required with email.provider: resend.
RESEND_API_KEY=
