ENV=local
NODE_ENV=development

# API Server Configuration
ADDRESS=:8080
PRIVATE_ADDRESS=:13011

# Postgres Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_APP_DB=app

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB_INDEX=0

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222

# GoJudge
GOJUDGE_GRPC_ADDR=localhost:5051
# JUDGE_TEMP_DIR=  # defaults to system temp dir + /judge (os.TempDir()/judge)

# S3 / SeaweedFS Configuration
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# Frontend URLs
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_BACKEND_API_URL=/api
BACKEND_API_URL=http://localhost/api
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080/ws

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
 
# Telemetry Configuration
NEXT_PUBLIC_OTEL_EXPORTER_URL=http://localhost/otlp/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=gate-frontend-browser
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=gate-frontend
GRAFANA_ADMIN_PASSWORD=admin

