# Secrets and connection strings for local development. Non-secret settings
# live in deploy/local/config.yaml. Copy this file to deploy/local/.env.

# Passwords of the Docker Compose services
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redis

# Backend connections to the Docker Compose services
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
REDIS_URL=redis://:redis@localhost:6379/0
NATS_URL=nats://localhost:4222
# Must match deploy/local/s3.json.
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
# Only needed with email.provider: resend.
RESEND_API_KEY=
