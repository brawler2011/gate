# Environment
ENV=local
NODE_ENV=development

# Backend Configuration
# Rate limiter: trusted proxy IP or DNS name; empty means direct clients only.
# Production Compose sets this to the Traefik container DNS name.
RATE_LIMIT_TRUSTED_PROXY=
ADDRESS=0.0.0.0:8080
LOCAL_STORAGE_PATH=backend/data
INBOX_RETENTION_DAYS=7

# Frontend Configuration
BACKEND_API_URL=http://localhost:8080

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis / Valkey (Docker Compose)
REDIS_PASSWORD=redis

# Optional manual database benchmarks: dedicated PostgreSQL 18 database only.
# Creates/drops isolated bench_* schemas; never use an application database.
BENCHMARK_DATABASE_URL=postgres://postgres:postgres@localhost:55426/gate_benchmarks?sslmode=disable
