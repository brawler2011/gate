# Environment
ENV=local
NODE_ENV=development

# Backend Configuration
ADDRESS=0.0.0.0:8080
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=gate-backend

# Frontend Configuration
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost/ws
NEXT_PUBLIC_OTEL_EXPORTER_URL=http://localhost/otlp/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=gate-frontend-browser

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis / Valkey (Docker Compose)
REDIS_PASSWORD=redis

# Grafana (Docker Compose)
GRAFANA_ADMIN_PASSWORD=admin
