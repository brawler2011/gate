# Domain & Deployment
DOMAIN_NAME=dev.steins.ru
IMAGE_TAG=dev

# Backend Configuration
BACKEND_ADDRESS=0.0.0.0:8080
BACKEND_PRIVATE_ADDRESS=0.0.0.0:8081
BACKEND_OTEL_ENDPOINT=otel-collector:4317
BACKEND_OTEL_SERVICE_NAME=gate-backend

# Frontend Configuration
BACKEND_API_URL=http://gate-backend-dev:8080
NEXT_PUBLIC_BACKEND_API_URL=/api
NEXT_PUBLIC_APP_URL=https://dev.steins.ru
NEXT_PUBLIC_WEBSOCKET_URL=wss://dev.steins.ru/ws
NEXT_PUBLIC_OTEL_EXPORTER_URL=https://dev.steins.ru/otlp/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=gate-frontend-browser
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=gate-frontend

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_APP_DB=dev_app

# Redis / Valkey
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_password
REDIS_DB_INDEX=0

# NATS
NATS_HOST=nats
NATS_PORT=4222

# S3 / SeaweedFS
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=gate_s3_key
S3_SECRET_KEY=replace_with_secure_key

# Grafana
GRAFANA_ADMIN_PASSWORD=replace_with_secure_admin_password
